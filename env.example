# XAgent 環境変数テンプレート。コピーして `.env` を作成し、値を埋める。
# 例:  cp env.example .env   （.env はコミットしない / .gitignore済み）

# --- Claude (整形エンジン: Claude Code CLI / サブスクリプション課金) ---
# LLM処理は Claude Code CLI のヘッドレス使い捨てセッションで行う(OAuth/subscription)。
# ANTHROPIC_API_KEY は使わない(設定されていても CLI 実行時の env から除去される)。
CLAUDE_MODEL=claude-opus-4-8
# claude コマンドのパス。空なら PATH → ~/.local/bin/claude の順で解決。
CLAUDE_CLI_PATH=
# CLI 1回の実行タイムアウト(秒)。フロントの fetch 既定(約300秒)内に収める。
CLAUDE_CLI_TIMEOUT_SECONDS=240

# --- X API ---
# 投稿/書き込みは OAuth1.0a (api key/secret + access token/secret)、読み取りは Bearer。
# X Developer Portal でアプリ登録して取得する。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- twitterapi.io (他人の投稿の読み取り用 / 安価・読取専用) ---
# 自分のアカウントの「操作」(投稿/RT)は上の公式Xのまま。読み取り(元投稿取得・監視・検索・
# 学習)はコスト削減のため twitterapi.io を優先し、失敗/ダウン時のみ公式Xにフォールバックする。
# 未設定なら読み取りも全て公式Xを使う(オプトイン)。キー発行: https://twitterapi.io/dashboard
TWITTERAPI_IO_KEY=

# --- DB ---
DB_PATH=xagent.db
# DBファイルの容量上限(バイト)。超えると古い端末状態(投稿済み/却下/取消=ゴミ箱)から
# 古い順に物理削除して縮める安全弁。既定2GB(2147483648)。通常は発動しない。
MAX_DB_BYTES=2147483648

# --- メディア(画像/動画)保存先 ---
MEDIA_DIR=media

# --- ポリシーガード(安全運用) ---
MAX_POSTS_PER_DAY=10
HARD_CAP_POSTS_PER_DAY=100
MIN_POST_INTERVAL_SECONDS=300
# 緊急停止スイッチ。false で手動/予約とも全投稿を停止する。
POSTING_ENABLED=true
# 予約投稿の自動発火(APIプロセス内の常駐スケジューラ)。false で予約の自動処理を止める。
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Web API (任意の認証) ---
# 値を設定すると、書き込み系APIで X-API-Token ヘッダが必須になる(クラウド公開時の保険)。
# 空ならローカル開放のまま。
API_TOKEN=

# --- 運用 ---
TIMEZONE=Asia/Tokyo
